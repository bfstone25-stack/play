class_name Rebound
## Port of play/rebound-tycoon/frontend/js/kernel.js — the table, the ledger, the eras,
## the prestige. Pure state (a Dictionary shaped exactly like the JS state object) and
## static functions; nothing here touches the scene tree. Every constant and formula is
## the JS one; tests/run_tests.gd replays tests/conformance.json (generated by running
## the real kernel.js in node) and asserts bit-identical positions, scores and events.
##
## Rounding traps (see tests/run_tests.gd "libm parity"): JS Math.hypot is Kahan-summed
## and scaled in V8 and is NOT sqrt(x*x+y*y) — hypot() below is V8's algorithm, which
## reproduces it bit for bit. pow/sin/cos go to the C library and are checked for parity
## on the inputs the table actually uses.

const SAVE_VERSION := 2
const GRAVITY := 1.35
const DAMP := 0.996
const MAX_SPEED := 2.6
const BALL_R := 0.017
const FLIP_LEN := 0.155
const FLIP_R := 0.016
const BALLS := 3
const COMBO_WINDOW_S := 2.2
const COMBO_CAP := 8
const COMBO_STEP := 0.12
const PRESTIGE_MIN_ERA := 1
const PRESTIGE_COIN_DIV := 4000
const SUBSTEPS := 4

const TABLE := {"left": 0.075, "right": 0.855, "top": 0.055, "bottom": 0.965,
	"laneL": 0.875, "laneR": 0.955, "drainL": 0.40, "drainR": 0.60}

const LEFT_PIVOT := Vector2(0.255, 0.865)
const RIGHT_PIVOT := Vector2(0.675, 0.865)
const LEFT_REST := 0.42
const LEFT_UP := -0.70
const RIGHT_REST := PI - 0.42
const RIGHT_UP := PI + 0.70

const BUMPERS := [
