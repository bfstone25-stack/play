; Engine configuration file.
config_version=5

[application]

config/name="PLICATA"
config/description="The fold-and-merge board, by lamplight. Every tier you clear folds one more layer off her. 18+."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.03, 0.06, 1)
boot_splash/show_image=false

[autoload]

Gate="*res://scripts/gate.gd"

Fold="*res://scripts/fold.gd"
Save="*res://scripts/save.gd"
I18n="*res://scripts/i18n.gd"
Sfx="*res://scripts/sfx.gd"
Juice="*res://scripts/juice.gd"
Coco="*res://scripts/companion.gd"
Tel="*res://scripts/tel.gd"
Tier="*res://scripts/tiers.gd"
Origami="*res://scripts/origami.gd"
Unlock="*res://scripts/unlock.gd"
Nutaku="*res://scripts/nutaku_f2p.gd"
F2P="*res://scripts/f2p.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

