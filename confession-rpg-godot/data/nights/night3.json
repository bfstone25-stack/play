            "hide_cg": true
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "key": "acc_who_adaeze",
      "auto_rank": 0,
      "do": [
       {
        "say": "narrator",
        "key": "acc_why"
       },
       {
        "choice": [
         {
          "menu": "It was going to close us. He did not say so. You do not have to say so.",
          "if_flag": "heard_ade3_report",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c3_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c3_epilogue"
           }
          ]
         },
         {
          "menu": "I sign nothing now. Somebody else can be on every page for a while.",
          "if_flag": "heard_ade3_after",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c3_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c3_epilogue"
           }
          ]
         },
         {
          "menu": "He has never asked me for one thing in six years. I used to find that restful.",
          "if_flag": "heard_ade3_nik",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c3_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c3_epilogue"
           }
          ]
         },
         {
          "menu": "A man who is never owed anything is a man who has already taken it.",
          "if_flag": "heard_ade3_owe",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c3_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c3_epilogue"
           }
          ]
         },
         {
          "menu": "There was a light in the office at one. From upstairs you can see it in the yard, on the wall. I watched it go out and I did not come down.",
          "if_flag": "heard_ade3_office",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c3_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c3_epilogue"
           }
          ]
         },
         {
          "key": "acc_back",
          "auto_rank": 1,
          "do": [
           {
            "hide_cg": true
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "key": "acc_who_vee",
      "auto_rank": 0,
      "do": [
       {
        "say": "narrator",
        "key": "acc_why"
       },
       {
        "choice": [
         {
          "menu": "You can hear the office through the vent. You cannot hear words. You can hear that there are words.",
          "if_flag": "heard_vee3_yard",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c3_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c3_epilogue"
           }
          ]
         },
         {
          "menu": "Two people. One of them doing most of it. Then one set of feet on the stairs, going down slow, like carrying.",
          "if_flag": "heard_vee3_heard",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c3_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c3_epilogue"
           }
          ]
         },
         {
          "menu": "Because last time I told the truth about a room I was standing in, it took eleven months off my life.",
          "if_flag": "heard_vee3_tell",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c3_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c3_epilogue"
           }
          ]
         },
         {
          "menu": "One person in this city to hear me say a thing and write it down the way I said it.",
          "if_flag": "heard_vee3_believe",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c3_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c3_epilogue"
           }
          ]
         },
         {
          "menu": "Slow on the way down. Quick on the way up. Nobody carries anything up.",
