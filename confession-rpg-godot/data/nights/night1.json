            "event": "c1_epilogue"
           }
          ]
         },
         {
          "menu": "Deliveries, ice, the cooler, the yard door. Everything that isn't for customers.",
          "if_flag": "heard_ade_kitchen",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c1_done"
