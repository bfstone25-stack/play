        "key": "acc_why"
       },
       {
        "choice": [
         {
          "menu": "He was selling. Not product — names. Mine was on the list he was building.",
          "if_flag": "heard_nik_marek",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c1_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c1_epilogue"
           }
          ]
         },
         {
          "menu": "Nine months of it. Every name on that list is still walking around being very calm.",
          "if_flag": "heard_nik_list",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c1_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c1_epilogue"
           }
          ]
         },
         {
          "menu": "Nothing was taken because nothing in there was worth what he already had in his head.",
          "if_flag": "heard_nik_money",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c1_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c1_epilogue"
           }
          ]
         },
         {
          "menu": "I don't go past the bar. Hasn't been my job since I stopped being cheap.",
          "if_flag": "heard_nik_room",
          "auto_rank": 0,
          "do": [
           {
            "flag": "c1_done"
           },
           {
            "hide_cg": true
           },
           {
            "bg": "precinct"
           },
           {
            "lines": "board:205-206"
           },
           {
            "event": "c1_epilogue"
           }
          ]
         },
         {
          "menu": "Somebody was past the bar. I heard the strip curtain. I did not look, because looking is how you end up on a list.",
