; Engine configuration file.
config_version=5

[application]

config/name="Cyber Fortune"
config/description="赛博求签 / Cyber Fortune. Tap the fish, shake the tube, turn a card, or let the reader tell you before you tell her. Mainstream, SFW. blazeCore Play · 情绪解药."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.078, 0.063, 0.063, 1)
boot_splash/show_image=false

[autoload]

Gate="*res://scripts/gate.gd"
Tx="*res://scripts/i18n.gd"
Fortune="*res://scripts/fortune.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
# Desktop window size. The canvas is 720x1280 because this line is phone-shaped, but
# Blaze's built-in panel is 1080 tall: an un-overridden window is clamped by the window
# manager and the layout lands shifted, with the wordmark and the menu cut off at the left
# edge. That is not a capture artifact -- it is what he would see at 5am. 594x1056 is the
# same 9:16 with room for a titlebar. The web and mobile exports are untouched.
window/size/window_width_override=594
window/size/window_height_override=1056
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.078, 0.063, 0.063, 1)
