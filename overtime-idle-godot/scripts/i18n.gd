	"f2p_sc_ot_juno_2": "Sonnenaufgang auf dem Balkon",
	"f2p_sc_ot_b7": "Die Bar des Marlowe",
	"f2p_sc_ot_lark_1": "Nach Feierabend",
	"f2p_sc_ot_lark_2": "Das Mitternachtslied",
	"f2p_sc_ot_odile_1": "Fast gelöst",
