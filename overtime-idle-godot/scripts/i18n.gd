	# ---- Nutaku F2P story: chapters, goals, rival bids. {n} = the goal's need, {target}/{hours} = the bid's; filled by f2p_ui.gd
	"f2p_ch_c1_title": "一层亮灯",
	"f2p_ch_c1_intro": "港湾街有五层楼，只有一盏灯还亮着。美玲把钥匙和一份搬走租户的名单交给你。街对面，卡斯特兰·沃斯在窗后举起酒杯，用口型说：“撑不过一个月。”",
	"f2p_ch_c1_g0": "开 {n} 层楼",
	"f2p_ch_c1_g1": "让一层达到 {n} 连锁",
	"f2p_ch_c1_g2": "与任何人累计获得 {n} 级好感",
	"f2p_ch_c1_outro": "三层楼亮了。美玲没说干得好，只是在你桌上多放了一杯咖啡——意思一样。",
	"f2p_ch_c2_title": "消防检查",
	"f2p_ch_c2_intro": "有人给市政府打了电话。卡明斯基检查员拿着记录板来了，面无表情。“每一层都要满到有人照看得过来，而且这栋楼里谁都不许挨着一个隔着耳机还说个不停的人干活。”沃斯送来一束花，卡片上写着：“祝你好运。”",
	"f2p_ch_c2_g0": "开满全部 {n} 层",
	"f2p_ch_c2_g1": "通过检查：每层至少 {n} 个棋子，且没有一层交韦斯税",
	"f2p_ch_c2_g2": "击败沃斯对租约的竞价",
	"f2p_ch_c2_boss_title": "沃斯竞价租约",
	"f2p_ch_c2_boss_text": "沃斯开价 {target} 买下租约，白纸黑字，还把钢笔留在了桌上。让美玲看看这栋楼值得更多：在接下来的 {hours} 小时内赚到 {target}。",
	"f2p_ch_c2_outro": "卡明斯基签了合格证。美玲把沃斯的报价撕成两半，钢笔留下了。“我们要买玻璃塔，”她说，“走的时候把这栋卖了。”",
	"f2p_ch_c3_title": "玻璃与债务",
	"f2p_ch_c3_intro": "玻璃塔很漂亮，也欠着派克·哈兰资本的钱。雅顿女士带着平板和微笑来访：“我们只是希望随时了解情况。”每一层都一眼看得穿，也就是说，谁都看得见哪几层是空的。",
	"f2p_ch_c3_g0": "开 {n} 层楼",
	"f2p_ch_c3_g1": "整栋累计 {n} 级装修",
	"f2p_ch_c3_g2": "人事名单上有 {n} 名员工",
	"f2p_ch_c3_outro": "雅顿的平板上，你的数字一路上涨。她不笑了——这是她做过的第一件诚实的事。",
	"f2p_ch_c4_title": "罢工",
	"f2p_ch_c4_intro": "夜班员工在午夜集体离岗，很有礼貌：要更好的椅子、更好的咖啡，还要有人肯听他们说话。他们说得对。派克的基金把这次罢工称为“违约事件”，开始起草竞价。",
	"f2p_ch_c4_g0": "每层装修到 {n} 级（更好的椅子）",
	"f2p_ch_c4_g1": "完成 {n} 个员工请求（有人肯听）",
	"f2p_ch_c4_g2": "开满全部 {n} 层",
	"f2p_ch_c4_g3": "击败派克·哈兰的竞价",
	"f2p_ch_c4_boss_title": "派克·哈兰的竞价",
	"f2p_ch_c4_boss_text": "雅顿对塔楼的债务提交了竞价：{target}，{hours} 小时后生效，除非这栋楼先赚到这个数。那就先赚到。",
	"f2p_ch_c4_outro": "员工们在一个星期二带着蛋糕回来了。派克的竞价无人理会，就此过期。美玲已经在夜市找好了下一栋楼。",
	"f2p_ch_c5_title": "灯笼",
	"f2p_ch_c5_intro": "夜市阁楼：纸灯笼、面条的热气，还有巷子里每隔一栋楼就挂起的“沃斯父女地产”招牌。你在塔楼的时候，沃斯一直在收购这片夜市。",
	"f2p_ch_c5_g0": "开 {n} 层楼",
	"f2p_ch_c5_g1": "好感度累计 {n} 级",
	"f2p_ch_c5_g2": "让一层达到 {n} 连锁",
	"f2p_ch_c5_outro": "整条巷子投票决定灯笼节在哪栋楼办。不是挂着沃斯招牌的那栋。",
	"f2p_ch_c6_title": "噪音投诉",
	"f2p_ch_c6_intro": "一份噪音投诉，投诉人原来是替沃斯做事的租户。卡明斯基又来了，满脸歉意：“规矩就是规矩。楼层要安静，也要住满，不然灯笼节期间我只能让你们停业。”",
	"f2p_ch_c6_g0": "开满全部 {n} 层",
	"f2p_ch_c6_g1": "没有一层交韦斯税（安静楼层）",
	"f2p_ch_c6_g2": "每层至少 {n} 个棋子",
	"f2p_ch_c6_g3": "赢下整条巷子的竞价战",
	"f2p_ch_c6_boss_title": "竞价战",
	"f2p_ch_c6_boss_text": "沃斯出价 {target} 收购整条巷子，阁楼也在其中。巷子的业主们给你 {hours} 小时，用这栋楼自己的收入跟上这个数。",
	"f2p_ch_c6_outro": "灯笼节照常举行。沃斯也来了，穿着一身极好的西装，从普莉娅手里买了一盏灯笼，全程没看她一眼。",
	"f2p_ch_c7_title": "子午大厦",
	"f2p_ch_c7_intro": "子午大厦是一栋真正的写字楼：大堂、电梯，还有一座没人关的喷泉。派克·哈兰拥有隔壁那栋楼，把董事会会议室的窗户正对着你这边。",
	"f2p_ch_c7_g0": "开 {n} 层楼",
	"f2p_ch_c7_g1": "员工等级合计达到 {n}",
	"f2p_ch_c7_g2": "整栋累计 {n} 级装修",
	"f2p_ch_c7_outro": "雅顿送来一篮水果，没附卡片。玛拉还是扫了一遍窃听器。有两个。",
	"f2p_ch_c8_title": "恶意收购",
	"f2p_ch_c8_intro": "派克·哈兰开始在公开市场上收购子午大厦的债务。要挡住收购，这栋楼就得看起来值得留下：妮娅要求在基金动手之前，让每一层都达标。",
	"f2p_ch_c8_g0": "开满全部 {n} 层",
	"f2p_ch_c8_g1": "审计：每层装修到 {n} 级",
	"f2p_ch_c8_g2": "挡住恶意收购",
	"f2p_ch_c8_boss_title": "收购",
	"f2p_ch_c8_boss_text": "基金亮出报价：{target}，收购子午大厦的债务。在 {hours} 小时内赚得比它多，董事会就不会卖。",
	"f2p_ch_c8_outro": "董事会以七比零否决了派克·哈兰的报价。出乎所有人意料，雅顿把辞职信寄给了美玲，还附上一份简历。",
	"f2p_ch_c9_title": "OCCUPANCY 一号",
	"f2p_ch_c9_intro": "就是这座塔楼。天际线上四十层，你能用上的有九层，全都黑着。沃斯握着这座塔的土地租约，从没让任何人在大堂以上建过东西。",
	"f2p_ch_c9_g0": "开 {n} 层楼",
	"f2p_ch_c9_g1": "好感度累计 {n} 级",
	"f2p_ch_c9_g2": "每小时收入达到 {n}",
	"f2p_ch_c9_outro": "塔楼的窗户一层接一层亮起来，全城都看得见。沃斯也看得见。",
	"f2p_ch_c10_title": "城市的钥匙",
	"f2p_ch_c10_intro": "沃斯和派克·哈兰难得联手：对土地租约、这座塔楼以及它底下的一切联合竞价。这是这条街上有人说出口的最大的数字。",
	"f2p_ch_c10_g0": "开满全部 {n} 层",
	"f2p_ch_c10_g1": "好感度累计 {n} 级",
	"f2p_ch_c10_g2": "击败联合竞价",
	"f2p_ch_c10_boss_title": "联合竞价",
	"f2p_ch_c10_boss_text": "两人合出 {target}，{hours} 小时后到期。这座塔得赚得比自己的身价还多。",
	"f2p_ch_c10_outro": "竞价失败了。沃斯二十年来第一次穿过这条街，先和美玲握手，再和你握手，问顶层有没有人。有。一路上遇到的每个人都在那儿，夜很暖。",
},
