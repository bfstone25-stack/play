	"f2p_sc_ot_mirei_1": "The lease, signed twice",
	"f2p_sc_ot_mirei_2": "Golden hour on the top floor",
	"f2p_sc_ot_dan_1": "Green build, late night",
	"f2p_sc_ot_dan_2": "The spare mug",
	"f2p_sc_ot_priya_1": "The corridor light",
	"f2p_sc_ot_priya_2": "Sunset on the roof",
