	# ---- Nutaku F2P content: names, scenes, lines, events, SKUs (en of record: ops/nutaku/overtime_f2p/content.json, config.example.json)
	"f2p_rival_voss": "Castellan Voss",
	"f2p_rival_pike": "Pike Harlan Capital",
	"f2p_rival_kaminski": "Inspector Ruth Kaminski",
	"f2p_bld_1": "Harbour Street",
	"f2p_bld_2": "The Glass Tower",
