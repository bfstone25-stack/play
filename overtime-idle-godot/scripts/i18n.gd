	"f2p_ev_ev_roof_title": "屋上パーティー",
	"f2p_ev_ev_roof_text": "プリヤには屋上の鍵と、ひとつの計画がある。",
	"f2p_ev_ev_press_title": "プレスウィーク",
	"f2p_ev_ev_press_text": "ソルがこの通りの記事を書いていて、ヴォスは訂正を求めている。",
	"f2p_ev_ev_pitch_title": "ピッチウィーク",
	"f2p_ev_ev_pitch_text": "ウェスがアーデンに建物を売り込み、アーデンも売り込み返している。",
	"f2p_sku_ticket_1_name": "スタッフチケット1枚",
