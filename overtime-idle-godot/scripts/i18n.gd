	"f2p_bn_bn_u5_title": "Caso sin resolver",
	"who_odile": "Opal",
	"f2p_pk_u6_title": "La escritura",
	"f2p_ev_uev_u6_title": "Archivo abierto",
	"f2p_ev_uev_u6_text": "Teo mantiene el archivo abierto hasta tarde, para quien lo pida.",
	"f2p_bn_bn_u6_title": "Primera edición",
