	"f2p_ev_uev_u3_title": "グランド・リオープン",
	"f2p_ev_uev_u3_text": "マーロウの扉がまた開いた。入口に立つのはジュノだ。",
	"f2p_bn_bn_u3_title": "スイート1204",
	"who_juno": "ジュノ",
	"f2p_pk_u4_title": "ラストオーダー",
