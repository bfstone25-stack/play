static func t(key: String, vars: Dictionary = {}) -> String:
	var bank: Dictionary = EN
	if Game.lang == "zh":
		bank = ZH
	elif Game.lang == "ja":
		bank = JA
	var s: String = bank.get(key, EN.get(key, key))
	for k in vars:
		s = s.replace("{" + k + "}", str(vars[k]))
	return s
