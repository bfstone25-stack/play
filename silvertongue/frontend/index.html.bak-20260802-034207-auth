    document.getElementById("tick").innerHTML=TIPS[L].join('&nbsp;&nbsp;&nbsp;◆&nbsp;&nbsp;&nbsp;')+ '&nbsp;&nbsp;&nbsp;◆&nbsp;&nbsp;&nbsp;';
  }
  refresh(); setInterval(refresh,1200);
})();
</script>

<script>
// 统一埋点SDK: 自动记录pageview/click/停留/会话时长, 手动记录chat/feedback
(function(){
  const API = window.SILVERTONGUE_API || window.APP_API || "";
  const pid = (function(){let p=localStorage.getItem("tel_pid");
    if(!p){p="u"+Math.random().toString(36).slice(2,10);localStorage.setItem("tel_pid",p);}return p;})();
  const sid = "s"+Math.random().toString(36).slice(2,10);
  const t0 = Date.now();
  let queue = [];
  function push(etype,name,value,dur){
    queue.push({pid,sid,etype,name:String(name||"").slice(0,120),
                value:typeof value==="string"?value:JSON.stringify(value||""),dur:dur||0});
    if(queue.length>=8) flush();
  }
  function flush(useBeacon){
    if(!queue.length||!API) return;
    const batch = queue.splice(0,50);
    const body = JSON.stringify(batch);
    if(useBeacon && navigator.sendBeacon){
      navigator.sendBeacon(API+"/tel_batch", new Blob([body],{type:"application/json"}));
    } else {
      fetch(API+"/tel_batch",{method:"POST",headers:{"Content-Type":"application/json"},body}).catch(()=>{});
    }
  }
  // 自动: pageview
  push("pageview", location.pathname||"/", document.title||"");
  // 自动: 所有click(记录元素id/class/文本)
  document.addEventListener("click", e=>{
    const el=e.target.closest("button,a,[data-tel],.card,.chip,[role=button]");
    if(!el)return;
    push("click", el.id||el.dataset.tel||el.className||el.tagName,
         (el.innerText||"").trim().slice(0,60));
  }, true);
  // 自动: 会话时长(离开时上报)
  window.addEventListener("beforeunload", ()=>{
    push("session_end","session","",Math.round((Date.now()-t0)/1000));
    flush(true);
  });
  document.addEventListener("visibilitychange", ()=>{ if(document.hidden) flush(true); });
  setInterval(()=>flush(), 20000);   // 定期flush
  // 暴露手动埋点: TEL.chat(用户消息,回复) / TEL.feedback(分数,留言) / TEL.ev(类型,名,值)
  window.TEL = {
    chat: (userMsg, reply, meta)=>push("chat","message",{u:String(userMsg).slice(0,800),r:String(reply).slice(0,1200),...(meta||{})}),
    feedback: (score, note)=>push("feedback","rating",{score,note:String(note||"").slice(0,500)}),
    ev: (name, value)=>push("custom",name,value),
    flush
  };
})();
</script>


<script>
/* 通用等待动画: 任何异步请求期间显示"思考中"呼吸提示, 零服务器成本 */
(function(){
  let _wt=null;
  const HINTS={zh:["正在思考…","整理中…","正在分析…","稍等一下…"],
               en:["thinking…","working on it…","analyzing…","one moment…"]};
  window.showWaiting=function(elId){
    const el=document.getElementById(elId)||document.querySelector("[data-wait]")||document.body;
    const zh=(document.documentElement.lang||navigator.language||"").toLowerCase().startsWith("zh");
    const hints=zh?HINTS.zh:HINTS.en;
    let d=0,hi=Math.floor(Math.random()*hints.length);
    window._waitEl=el; window._waitPrev=el.innerHTML;
    _wt=setInterval(()=>{d=(d+1)%4;
      el.innerHTML=`<div style="opacity:.6;font-style:italic;padding:12px">${hints[hi]}${".".repeat(d)}</div>`;
      if(d===0&&Math.random()<0.3)hi=(hi+1)%hints.length;},520);
  };
  window.hideWaiting=function(){if(_wt){clearInterval(_wt);_wt=null;}};
})();
</script>


