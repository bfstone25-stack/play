let AC=null,MASTER=null,MUSIC_BUS=null,AMBIENCE_BUS=null,SFX_BUS=null,ambienceStarted=false,themeTimer=null,themePlaying=false;
function ac(){if(!AC){AC=new (window.AudioContext||window.webkitAudioContext)();MASTER=AC.createGain();MUSIC_BUS=AC.createGain();AMBIENCE_BUS=AC.createGain();SFX_BUS=AC.createGain();MUSIC_BUS.connect(MASTER);AMBIENCE_BUS.connect(MASTER);SFX_BUS.connect(MASTER);MASTER.connect(AC.destination);applyAudioLevels();}if(AC.state==="suspended")AC.resume();return AC;}
function applyAudioLevels(){initMediaAudio();THEME_AUDIO.volume=Math.max(0,Math.min(1,AUDIO_CFG.master*AUDIO_CFG.music));GAME_AUDIO.volume=Math.max(0,Math.min(1,AUDIO_CFG.master*AUDIO_CFG.music*.62));if(!MASTER)return;MASTER.gain.value=AUDIO_CFG.master;MUSIC_BUS.gain.value=0;AMBIENCE_BUS.gain.value=0;SFX_BUS.gain.value=AUDIO_CFG.sfx;}
function startGameplayMusic(){initMediaAudio();applyAudioLevels();GAME_AUDIO.currentTime=0;GAME_AUDIO.play().catch(()=>{});}
