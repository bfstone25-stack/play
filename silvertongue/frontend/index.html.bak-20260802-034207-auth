function tone(freq,t0,dur,type,gain,bus="sfx"){
 const a=ac(),o=a.createOscillator(),g=a.createGain(),dest=bus==="music"?MUSIC_BUS:SFX_BUS;
 o.type=type;o.frequency.value=freq;o.connect(g);g.connect(dest);
 g.gain.setValueAtTime(0,a.currentTime+t0);
 g.gain.linearRampToValueAtTime(gain,a.currentTime+t0+.02);
 g.gain.exponentialRampToValueAtTime(.001,a.currentTime+t0+dur);
 o.start(a.currentTime+t0);o.stop(a.currentTime+t0+dur+.05);
}
function motif(kind){
 const notes={arrival:[369.99,440,554.37,493.88],question:[440,466.16],reply:[554.37,493.88,440],win:[369.99,440,554.37,659.25],lose:[440,415.3,329.63]}[kind]||[];
 try{notes.forEach((f,i)=>tone(f,i*.115,.3,kind==="lose"?"sawtooth":"triangle",kind==="question"?.04:.065,"sfx"));}catch(e){}
}
function musicNote(freq,when,dur,gain=.05,voice="reed"){
 const a=ac(),g=a.createGain(),o1=a.createOscillator(),o2=a.createOscillator(),f=a.createBiquadFilter();
 o1.type=voice==="pluck"?"triangle":"sine";o2.type=voice==="pluck"?"sine":"triangle";
 o1.frequency.value=freq;o2.frequency.value=freq*2;o2.detune.value=voice==="reed"?7:0;
 f.type="lowpass";f.frequency.value=voice==="pluck"?1600:1100;o1.connect(f);o2.connect(f);f.connect(g);g.connect(MUSIC_BUS);
 const t=a.currentTime+when;g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(gain,t+.025);
 g.gain.exponentialRampToValueAtTime(.0001,t+dur);o1.start(t);o2.start(t);o1.stop(t+dur+.04);o2.stop(t+dur+.04);
}
function playTheme(){
 if(themePlaying||AUDIO_CFG.music<=0)return;themePlaying=true;const beat=.285;
 // Original "Silver Waltz": a 6/8 conversational melody in E minor that
 // alternates question/answer phrases, then turns into a brighter G-major close.
 const melody=[64,67,71,69,67,66,64,67,71,74,71,69,67,71,76,74,71,69,
  66,69,74,72,69,67,64,67,71,69,66,62,67,71,74,79,78,74,
  71,74,79,81,79,78,76,74,71,69,71,74,76,79,83,81,79,76,
  74,71,69,67,71,74,79,78,76,74,71,67,69,71,74,72,71,67];
 const bass=[40,47,43,50,45,52,40,47,43,50,47,54];
 const midi=n=>440*Math.pow(2,(n-69)/12);
 try{
  melody.forEach((n,i)=>musicNote(midi(n),i*beat,i%6===5?beat*.92:beat*.72,i>47?.052:.045,"reed"));
  bass.forEach((n,i)=>{const t=i*6*beat;musicNote(midi(n),t,beat*.8,.05,"pluck");musicNote(midi(n+7),t+2*beat,beat*.55,.025,"pluck");musicNote(midi(n+12),t+4*beat,beat*.55,.022,"pluck");});
  [64,67,71,74].forEach((n,i)=>musicNote(midi(n),melody.length*beat-.9+i*.11,1.25,.026,"reed"));
 }catch(e){}
 setTimeout(()=>{themePlaying=false},Math.ceil((melody.length*beat+1.5)*1000));
}
