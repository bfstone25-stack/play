function uxOpenFb(){const t=uxT();uxScore=0;
 document.getElementById("uxFbQ").textContent=t.q;
 document.getElementById("uxFbNote").placeholder=t.ph;
 const sb=document.getElementById("uxFbSend");sb.textContent=t.send;sb.disabled=true;
 uxEmos();document.getElementById("uxFbOv").classList.add("show");}
function uxCloseFb(){document.getElementById("uxFbOv").classList.remove("show");}
