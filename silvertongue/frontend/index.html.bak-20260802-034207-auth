<script>
/* 评价UI - 跟随界面语言(避免英文界面出现中文) */
(function(){
  function isZH(){
    // 1. app自己的语言状态(最可靠)
    try{ if(typeof lang!=="undefined") return String(lang).toLowerCase().startsWith("zh"); }catch(e){}
    try{ const ls=localStorage.getItem("lang")||localStorage.getItem("locale");
         if(ls) return ls.toLowerCase().startsWith("zh"); }catch(e){}
    // 2. URL参数
    const u=new URLSearchParams(location.search).get("lang");
    if(u) return u.toLowerCase().startsWith("zh");
    // 3. html lang属性
    const h=(document.documentElement.lang||"").toLowerCase();
    if(h.startsWith("zh")) return true;
    if(h.startsWith("en")) return false;
    // 4. 兜底: 浏览器语言(不再扫描页面中文,避免误判)
    return (navigator.language||"").toLowerCase().startsWith("zh");
  }
  const T={
    zh:{btn:"\u2661 \u8bc4\u4ef7",q:"\u7528\u5f97\u8fd8\u987a\u624b\u5417\uff1f",ph:"\u60f3\u8bf4\u70b9\u4ec0\u4e48\u2026\uff08\u53ef\u9009\uff09",send:"\u53d1\u9001 \u2661",done:"\u6536\u5230\u5566 \u2661 \u8c22\u8c22\u4f60"},
    en:{btn:"\u2661 Rate",q:"How's it working for you?",ph:"Anything you'd like to tell us? (optional)",send:"Send \u2661",done:"Got it \u2661 Thank you"}
  };
  window.uxT=function(){return isZH()?T.zh:T.en;};
  window.uxSyncLabels=function(){
    const t=uxT(), b=document.getElementById("uxFbBtn");
    if(b)b.textContent=t.btn;
  };
  document.addEventListener("DOMContentLoaded",uxSyncLabels);
  setTimeout(uxSyncLabels,300);
})();
let uxScore=0;
function uxEmos(){const es=[["\ud83d\ude0d",3],["\ud83d\ude10",2],["\ud83e\udd71",1]];
 document.getElementById("uxFbEmos").innerHTML=es.map(([e,s])=>
