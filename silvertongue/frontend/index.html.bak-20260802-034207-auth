function fadeThemeOut(){
 initMediaAudio();
 const start=THEME_AUDIO.volume,themeTarget=Math.max(0,Math.min(1,AUDIO_CFG.master*AUDIO_CFG.music)),gameTarget=Math.max(0,Math.min(1,AUDIO_CFG.master*AUDIO_CFG.music*.62));let step=0;
 GAME_AUDIO.currentTime=0;GAME_AUDIO.volume=0;GAME_AUDIO.play().catch(()=>{});
 const fade=setInterval(()=>{step++;THEME_AUDIO.volume=Math.max(0,start*(1-step/15));GAME_AUDIO.volume=gameTarget*(step/15);if(step>=15){clearInterval(fade);THEME_AUDIO.pause();THEME_AUDIO.currentTime=0;THEME_AUDIO.volume=themeTarget;GAME_AUDIO.volume=gameTarget;}},100);
