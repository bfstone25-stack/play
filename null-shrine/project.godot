; Engine configuration file.
config_version=5

[application]
config/name="Midnight Pawn & Crypt"
config/description="2D pixel micro shop + mini dungeon hybrid RPG. Day tend the pawn shop; night dive the crypt."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.08, 0.06, 0.1, 1)

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.05, 0.08, 1)

