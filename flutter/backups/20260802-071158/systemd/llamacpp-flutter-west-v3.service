[Unit]
Description=Flutter Psyche V3 west lane (Llama 3 8B + LoRA)
After=network.target

[Service]
ExecStart=%h/llama.cpp/cpu/llama-b9911/llama-server -m %h/llama.cpp/models/llama3-8b-it-q4.gguf --lora %h/Projects/apps/flutter/models/psyche-v3/west/flutter-west-psyche-v3-f16.gguf -c 4096 -t 10 --host 127.0.0.1 --port 8851
Restart=on-failure

[Install]
WantedBy=default.target
