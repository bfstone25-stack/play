    for name, spec in log_reasoning_cols.items():
        if name not in existing:
            c.execute(f"ALTER TABLE distill_log ADD COLUMN {name} {spec}")
    c.execute("""CREATE TABLE IF NOT EXISTS detective_accounts(
        account_id TEXT PRIMARY KEY, email TEXT UNIQUE NOT NULL, name TEXT DEFAULT '',
