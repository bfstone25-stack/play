def _telegram_send(chat_id, text, business_connection_id=""):
    """Send without ever placing the bot token in logs or response bodies."""
    if not TELEGRAM_BOT_TOKEN or not chat_id:
        return False
    data = {"chat_id": str(chat_id), "text": str(text)[:4000]}
    if business_connection_id:
        data["business_connection_id"] = str(business_connection_id)
    payload = json.dumps(data).encode()
    req = urllib.request.Request(
        f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage",
        data=payload, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=8) as response:
            return response.status == 200
    except Exception:
        return False


def _telegram_business_update(update_id, update):
    """Persist Secretary connections and acknowledge new managed chats safely."""
    connection = update.get("business_connection") or {}
    if connection:
        rights = connection.get("rights") or {}
        connection_id = str(connection.get("id") or "")
        if connection_id:
            db = _db()
            db.execute("""INSERT OR REPLACE INTO telegram_business_connections(
                connection_id,user_chat_id,enabled,can_reply,updated) VALUES(?,?,?,?,?)""",
                (connection_id, str(connection.get("user_chat_id") or ""),
                 int(bool(connection.get("is_enabled"))), int(bool(rights.get("can_reply"))),
                 time.time()))
            db.commit(); db.close()
        return True

    edited = bool(update.get("edited_business_message"))
    message = update.get("business_message") or update.get("edited_business_message") or {}
    if not message:
        return False
    connection_id = str(message.get("business_connection_id") or "")
    chat = message.get("chat") or {}
    sender = message.get("from") or {}
    chat_id = str(chat.get("id") or "")
    text = str(message.get("text") or message.get("caption") or "").strip()[:1500]
    if not connection_id or not chat_id or not text:
        return True
    if str(sender.get("id") or "") == str(TELEGRAM_ADMIN_CHAT_ID or ""):
        return True
    db = _db()
    duplicate = db.execute(
        "SELECT 1 FROM telegram_business_messages WHERE update_id=?", (update_id,)).fetchone()
    if not duplicate:
        db.execute("""INSERT INTO telegram_business_messages(
            update_id,ts,connection_id,message_id,chat_id,sender_id,username,text,replied)
            VALUES(?,?,?,?,?,?,?,?,0)""",
            (update_id, time.time(), connection_id, int(message.get("message_id") or 0),
             chat_id, str(sender.get("id") or ""), str(sender.get("username") or "")[:64], text))
        db.commit()
    db.close()
    if duplicate:
        return True
    if edited:
        return True
    username = str(sender.get("username") or "")
    english_only = username.lower() == "xx7890123"
    zh = (not english_only and
          str(sender.get("language_code") or "").lower().startswith("zh"))
    reply = ("你好，我是 TELL 助手。消息已经收到，我会先整理内容；需要本人决定的事项会转交人工处理。"
             if zh else "Hello, this is the TELL assistant. Your message has been received. "
             "Anything requiring a personal decision will be handed to a human.")
    replied = _telegram_send(chat_id, reply, connection_id)
    if replied:
        db = _db()
        db.execute("UPDATE telegram_business_messages SET replied=1 WHERE update_id=?", (update_id,))
        db.commit(); db.close()
    if TELEGRAM_ADMIN_CHAT_ID:
        who = "@" + sender.get("username", "") if sender.get("username") else "business contact"
        _telegram_send(TELEGRAM_ADMIN_CHAT_ID, f"Secretary message from {who}\n\n{text}")
    return True


@app.post("/telegram/webhook")
async def telegram_webhook(request: Request):
    """Private Telegram Bot API ingress for player feedback.

    Telegram supplies the configured secret in a header. Updates are keyed by
    update_id so retries cannot create duplicate feedback rows.
    """
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_WEBHOOK_SECRET:
        raise HTTPException(503, "telegram feedback is not configured")
    supplied = request.headers.get("x-telegram-bot-api-secret-token", "")
    if not hmac.compare_digest(supplied, TELEGRAM_WEBHOOK_SECRET):
        raise HTTPException(403, "invalid webhook secret")
    try:
        update = await request.json()
        update_id = int(update["update_id"])
    except Exception:
        raise HTTPException(400, "invalid update")

    if _telegram_business_update(update_id, update):
        return {"ok": True}

    message = update.get("message") or update.get("edited_message") or {}
    chat = message.get("chat") or {}
    sender = message.get("from") or {}
    chat_id = str(chat.get("id") or "")
    text = str(message.get("text") or message.get("caption") or "").strip()[:1500]
    if not chat_id or not text:
        return {"ok": True}

    command = text.split(None, 1)[0].split("@", 1)[0].lower()
    score = int(text) if text in {"1", "2", "3"} else 0
    db = _db()
    duplicate = db.execute(
        "SELECT 1 FROM telegram_feedback WHERE update_id=?", (update_id,)).fetchone()
    if not duplicate:
        db.execute("""INSERT INTO telegram_feedback(
            update_id,ts,message_id,chat_id,user_id,username,language_code,text,score,forwarded)
            VALUES(?,?,?,?,?,?,?,?,?,0)""",
            (update_id, time.time(), int(message.get("message_id") or 0), chat_id,
             str(sender.get("id") or ""), str(sender.get("username") or "")[:64],
             str(sender.get("language_code") or "")[:16], text, score))
        db.commit()
    db.close()
    if duplicate:
        return {"ok": True}

    zh = str(sender.get("language_code") or "").lower().startswith("zh")
    if command == "/start":
        reply = ("这里是《破绽 TELL》官方反馈入口。请直接描述遇到的问题；"
                 "也可以发送 1、2 或 3 进行评分。我们会结合关卡数据改进游戏。") if zh else (
                 "This is the official TELL feedback desk. Describe what happened, "
                 "or send 1, 2, or 3 as a rating. Your report helps improve each case.")
        _telegram_send(chat_id, reply)
        return {"ok": True}

    if TELEGRAM_ADMIN_CHAT_ID:
        who = "@" + sender.get("username", "") if sender.get("username") else "anonymous player"
        label = f"rating {score}/3" if score else "written feedback"
        forwarded = _telegram_send(
            TELEGRAM_ADMIN_CHAT_ID,
            f"TELL · {label}\nFrom: {who}\nLanguage: {sender.get('language_code','unknown')}\n\n{text}")
        if forwarded:
            db = _db()
            db.execute("UPDATE telegram_feedback SET forwarded=1 WHERE update_id=?", (update_id,))
            db.commit(); db.close()
    confirmation = ("反馈已归档。感谢你帮助我们找到破绽。") if zh else (
        "Your report is now in the case file. Thank you for helping us find the flaw.")
    _telegram_send(chat_id, confirmation)
    return {"ok": True}

@app.get("/analytics/summary")
def analytics_summary(days: int = 30):
    """Aggregate-only operations view: no raw questions, replies, notes, or player IDs."""
    days = max(1, min(days, 365))
    since = time.time() - days * 86400
    db = _db()
    totals = db.execute("""SELECT count(*),sum(correct),avg(questions),avg(elapsed_s)
                           FROM completions WHERE ts>=? AND traffic_class='organic' AND lang!='legacy'""", (since,)).fetchone()
    def grouped(column):
        return [dict(key=k or "unknown", attempts=n, solves=w or 0,
                     solve_rate=round(100*(w or 0)/n, 1), avg_questions=round(q or 0, 1))
                for k,n,w,q in db.execute(
                    f"""SELECT {column},count(*),sum(correct),avg(questions)
                        FROM completions WHERE ts>=? AND traffic_class='organic' AND lang!='legacy'
                        GROUP BY {column} ORDER BY count(*) DESC""",
                    (since,)).fetchall()]
    feedback_row = db.execute(
        "SELECT count(*),avg(score),sum(CASE WHEN note!='' THEN 1 ELSE 0 END) FROM feedback WHERE ts>=?",
        (since,)).fetchone()
    ai_row = db.execute(
        "SELECT count(*),avg(latency_ms),max(latency_ms) FROM distill_log WHERE ts>=? AND traffic_class='organic' AND lang!='legacy'",
        (since,)).fetchone()
    reasoning_row = db.execute("""SELECT count(*),
        sum(CASE WHEN fallback_reason!='' THEN 1 ELSE 0 END),
        sum(CASE WHEN evidence_stage='contradiction_exposed' THEN 1 ELSE 0 END),
        avg(route_confidence) FROM distill_log
        WHERE ts>=? AND traffic_class='organic' AND lang!='legacy' AND intent!=''""", (since,)).fetchone()
    intent_rows = db.execute("""SELECT intent,count(*) FROM distill_log
        WHERE ts>=? AND traffic_class='organic' AND lang!='legacy' AND intent!=''
        GROUP BY intent ORDER BY count(*) DESC""", (since,)).fetchall()
    telegram_row = db.execute("""SELECT count(*),
        sum(CASE WHEN score>0 THEN 1 ELSE 0 END),
        avg(CASE WHEN score>0 THEN score END),
        sum(CASE WHEN score=0 AND text NOT LIKE '/%' THEN 1 ELSE 0 END)
        FROM telegram_feedback WHERE ts>=?""", (since,)).fetchone()
    by_language, by_mode = grouped("lang"), grouped("mode")
    by_difficulty, by_case = grouped("difficulty"), grouped("case_id")
    db.close()

    telemetry = {"events": 0, "users": 0, "sessions": 0, "by_type": {},
                 "funnel": [], "daily_active": []}
    tel_db = os.path.abspath(os.path.join(HERE, "..", "..", "data", "telemetry.db"))
    if os.path.exists(tel_db):
        tdb = sqlite3.connect(tel_db)
        row = tdb.execute("""SELECT count(*),count(DISTINCT pid),count(DISTINCT sid)
                             FROM events WHERE app='tell' AND ts>=?""", (since,)).fetchone()
        telemetry.update(events=row[0], users=row[1], sessions=row[2])
        telemetry["by_type"] = dict(tdb.execute(
            "SELECT etype,count(*) FROM events WHERE app='tell' AND ts>=? GROUP BY etype",
            (since,)).fetchall())
        funnel_names = ["game_start","case_loaded","interrogation_start","question_answered",
                        "accusation_result","case_solved","feedback_submitted"]
        telemetry["funnel"] = [
            dict(step=name, sessions=tdb.execute(
                """SELECT count(DISTINCT sid) FROM events
                   WHERE app='tell' AND ts>=? AND etype='custom' AND name=?""",
                (since, name)).fetchone()[0]) for name in funnel_names]
        daily = tdb.execute("""SELECT date(ts,'unixepoch'),count(DISTINCT pid)
                               FROM events WHERE app='tell' AND ts>=? AND etype='pageview'
                               GROUP BY date(ts,'unixepoch') ORDER BY 1""", (since,)).fetchall()
        telemetry["daily_active"] = [dict(day=d, users=n) for d,n in daily]
        tdb.close()
    attempts, solves, avg_q, avg_elapsed = totals
    return {
        "period_days": days,
        "game": {"attempts": attempts or 0, "solves": solves or 0,
                 "solve_rate": round(100*(solves or 0)/attempts, 1) if attempts else 0,
                 "avg_questions": round(avg_q or 0, 1),
                 "avg_elapsed_s": round(avg_elapsed or 0, 1)},
        "by_language": by_language, "by_mode": by_mode,
        "by_difficulty": by_difficulty, "by_case": by_case,
        "feedback": {"ratings": feedback_row[0], "average": round(feedback_row[1] or 0, 2),
                     "written_notes": feedback_row[2] or 0,
                     "telegram_messages": telegram_row[0] or 0,
                     "telegram_ratings": telegram_row[1] or 0,
                     "telegram_average": round(telegram_row[2] or 0, 2),
                     "telegram_written": telegram_row[3] or 0},
        "ai": {"answers": ai_row[0], "avg_latency_ms": round(ai_row[1] or 0),
               "max_latency_ms": ai_row[2] or 0},
        "reasoning": {"routed_turns": reasoning_row[0] or 0,
                      "fallbacks": reasoning_row[1] or 0,
                      "fallback_rate": round(100*(reasoning_row[1] or 0)/reasoning_row[0],1) if reasoning_row[0] else 0,
                      "contradictions_exposed": reasoning_row[2] or 0,
                      "avg_route_confidence": round(reasoning_row[3] or 0,2),
                      "by_intent": dict(intent_rows)},
        "telemetry": telemetry
    }

