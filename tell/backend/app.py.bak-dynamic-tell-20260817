document.getElementById("cards").innerHTML=[["ACTIVE USERS",t.users],["SESSIONS",t.sessions],["ATTEMPTS",g.attempts],["SOLVE RATE",g.solve_rate+"%"],["AVG QUESTIONS",g.avg_questions],["AVG TIME",g.avg_elapsed_s+"s"],["RATING",f.average||"—"],["TG FEEDBACK",f.telegram_written||0],["TG RATING",f.telegram_average||"—"],["AI LATENCY",a.avg_latency_ms+"ms"],["RULE FALLBACK",(r.fallback_rate||0)+"%"],["EVIDENCE BREAKS",r.contradictions_exposed||0]].map(x=>`<div class="card">${x[0]}<b>${x[1]}</b></div>`).join("");
const max=Math.max(1,...t.funnel.map(x=>x.sessions));document.getElementById("funnel").innerHTML=t.funnel.map(x=>`<div class="bar" style="height:${Math.max(3,x.sessions/max*130)}px"><span>${x.step}<br>${x.sessions}</span></div>`).join("");
document.getElementById("langs").innerHTML=table(d.by_language);document.getElementById("modes").innerHTML=table(d.by_mode);document.getElementById("diffs").innerHTML=table(d.by_difficulty);document.getElementById("cases").innerHTML=table(d.by_case)}
load();</script></main>"""
