def day_index(): return (date.today() - EPOCH).days
def todays(): return CASES[day_index() % len(CASES)]
def case_for(mode: str = "daily", case_index: int = 0):
    """Daily mode is date-bound; Case Run follows its explicit case cursor."""
    if mode == "run":
        return CASES[case_index % len(CASES)]
    return todays()
def suspect_by_id(case, sid): return next((s for s in case["suspects"] if s["id"] == sid), None)

def _token_hash(token):
    return hashlib.sha256(token.encode()).hexdigest()

def _session_account(request):
    token = request.cookies.get(SESSION_COOKIE, "")
    if not token:
        return None
    db = _db()
    row = db.execute("""SELECT a.account_id,a.email,a.name,a.picture
        FROM auth_sessions s JOIN detective_accounts a ON a.account_id=s.account_id
        WHERE s.token_hash=? AND s.revoked=0 AND s.expires>?""",
        (_token_hash(token), time.time())).fetchone()
    db.close()
    return dict(zip(("account_id", "email", "name", "picture"), row)) if row else None

def _link_pid(db, account_id, pid):
    pid = (pid or "").strip()[:64]
    if pid:
        db.execute("""INSERT INTO account_pids(account_id,pid,linked_at) VALUES(?,?,?)
            ON CONFLICT(pid) DO UPDATE SET account_id=excluded.account_id,linked_at=excluded.linked_at""",
            (account_id, pid, time.time()))

def _issue_session(response, account_id):
    token = secrets.token_urlsafe(32)
    db = _db()
    db.execute("INSERT INTO auth_sessions VALUES(?,?,?,?,0)",
               (_token_hash(token), account_id, time.time(), time.time() + SESSION_TTL))
    db.commit(); db.close()
    response.set_cookie(SESSION_COOKIE, token, max_age=SESSION_TTL, httponly=True,
                        secure=True, samesite="lax", path="/tell")

def _progress(db, account_id):
    pids = [r[0] for r in db.execute("SELECT pid FROM account_pids WHERE account_id=?", (account_id,))]
    if not pids:
        return {"attempts": 0, "solves": 0, "cases": 0, "best_streak": 0}
    marks = ",".join("?" for _ in pids)
    row = db.execute(f"""SELECT count(*),coalesce(sum(correct),0),
        count(DISTINCT CASE WHEN correct=1 THEN case_id END),coalesce(max(run_streak),0)
        FROM completions WHERE pid IN ({marks}) AND traffic_class='organic'""", pids).fetchone()
    return dict(zip(("attempts", "solves", "cases", "best_streak"), row))

class GoogleAuthReq(BaseModel):
    credential: str
    anonymous_pid: str = ""

class MagicAuthReq(BaseModel):
    email: str
    anonymous_pid: str = ""

@app.get("/auth/config")
def auth_config():
    return {"google_enabled": bool(GOOGLE_CLIENT_ID and google_id_token),
            "google_client_id": GOOGLE_CLIENT_ID if google_id_token else "",
            "email_enabled": bool(RESEND_API_KEY and TELL_EMAIL_FROM)}

@app.get("/auth/me")
def auth_me(request: Request, pid: str = ""):
    account = _session_account(request)
    if not account:
        return {"authenticated": False}
    db = _db(); _link_pid(db, account["account_id"], pid)
    progress = _progress(db, account["account_id"]); db.commit(); db.close()
    account.pop("account_id", None)
    return {"authenticated": True, "account": account, "progress": progress}

@app.post("/auth/google")
def auth_google(r: GoogleAuthReq):
    if not GOOGLE_CLIENT_ID or not google_id_token:
        raise HTTPException(503, "Google sign-in is not configured")
    try:
        info = google_id_token.verify_oauth2_token(
            r.credential, google_requests.Request(), GOOGLE_CLIENT_ID)
    except Exception:
        raise HTTPException(401, "Invalid Google identity token")
    if not info.get("email") or not info.get("email_verified"):
        raise HTTPException(401, "Verified email required")
    now = time.time(); email = info["email"].lower().strip(); sub = str(info.get("sub", ""))
    db = _db()
    row = db.execute("SELECT account_id FROM detective_accounts WHERE email=?", (email,)).fetchone()
    account_id = row[0] if row else secrets.token_hex(16)
    db.execute("""INSERT INTO detective_accounts
        (account_id,email,name,picture,provider,provider_sub,created,last_login)
        VALUES(?,?,?,?,?,?,?,?) ON CONFLICT(email) DO UPDATE SET
        name=excluded.name,picture=excluded.picture,provider='google',
        provider_sub=excluded.provider_sub,last_login=excluded.last_login""",
        (account_id, email, str(info.get("name", ""))[:100], str(info.get("picture", ""))[:500],
         "google", sub, now, now))
    _link_pid(db, account_id, r.anonymous_pid); db.commit()
    progress = _progress(db, account_id); db.close()
    response = JSONResponse({"authenticated": True,
        "account": {"email": email, "name": str(info.get("name", "")), "picture": str(info.get("picture", ""))},
        "progress": progress})
    _issue_session(response, account_id)
    return response

@app.post("/auth/logout")
def auth_logout(request: Request):
    token = request.cookies.get(SESSION_COOKIE, "")
    if token:
        db = _db(); db.execute("UPDATE auth_sessions SET revoked=1 WHERE token_hash=?", (_token_hash(token),))
        db.commit(); db.close()
    response = JSONResponse({"ok": True})
    response.delete_cookie(SESSION_COOKIE, path="/tell")
    return response

@app.post("/auth/magic/request")
def auth_magic_request(r: MagicAuthReq, request: Request):
    if not RESEND_API_KEY or not TELL_EMAIL_FROM:
        raise HTTPException(503, "Email sign-in is not configured")
    email = r.email.lower().strip()
    if not re.fullmatch(r"[^\s@]+@[^\s@]+\.[^\s@]+", email) or len(email) > 254:
        raise HTTPException(400, "Invalid email")
    now = time.time(); ip = request.client.host if request.client else ""
    ip_hash = hashlib.sha256(ip.encode()).hexdigest()[:20]
    db = _db()
    recent = db.execute("SELECT count(*) FROM magic_links WHERE email=? AND created>?", (email, now-3600)).fetchone()[0]
    ip_recent = db.execute("SELECT count(*) FROM magic_links WHERE ip_hash=? AND created>?", (ip_hash, now-3600)).fetchone()[0]
    if recent >= 5 or ip_recent >= 12:
        db.close(); raise HTTPException(429, "Please wait before requesting another link")
    token = secrets.token_urlsafe(32)
    db.execute("INSERT INTO magic_links VALUES(?,?,?,?,?,?,?)",
               (_token_hash(token), email, r.anonymous_pid[:64], now, now+900, 0, ip_hash))
    db.commit(); db.close()
    link = TELL_PUBLIC_URL + "/auth/magic/consume?token=" + token
    payload = json.dumps({"from": TELL_EMAIL_FROM, "to": [email], "subject": "Your TELL detective file",
        "html": "<div style='background:#101113;color:#ddd;padding:28px;font-family:Georgia,serif'><h2>TELL · DETECTIVE FILE</h2><p>Your sealed access link is ready.</p><p><a style='color:#d4a24e' href='" + link + "'>OPEN DETECTIVE FILE</a></p><small>This link expires in 15 minutes.</small></div>"}).encode()
    req = urllib.request.Request("https://api.resend.com/emails", data=payload,
        headers={"Authorization": "Bearer " + RESEND_API_KEY, "Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=12) as sent:
            if sent.status >= 300: raise RuntimeError("email rejected")
    except Exception:
        raise HTTPException(502, "Could not send access link")
    return {"ok": True}

@app.get("/auth/magic/consume")
def auth_magic_consume(token: str = ""):
    db = _db(); now = time.time()
    row = db.execute("SELECT email,pid FROM magic_links WHERE token_hash=? AND consumed=0 AND expires>?",
                     (_token_hash(token), now)).fetchone()
    if not row:
        db.close(); return RedirectResponse(TELL_PUBLIC_URL + "/?auth=expired", status_code=303)
    email, pid = row
    found = db.execute("SELECT account_id FROM detective_accounts WHERE email=?", (email,)).fetchone()
    account_id = found[0] if found else secrets.token_hex(16)
    db.execute("""INSERT INTO detective_accounts(account_id,email,provider,provider_sub,created,last_login)
        VALUES(?,?,?,?,?,?) ON CONFLICT(email) DO UPDATE SET last_login=excluded.last_login""",
        (account_id, email, "email", email, now, now))
    db.execute("UPDATE magic_links SET consumed=1 WHERE token_hash=?", (_token_hash(token),))
    _link_pid(db, account_id, pid); db.commit(); db.close()
    response = RedirectResponse(TELL_PUBLIC_URL + "/?auth=linked", status_code=303)
    _issue_session(response, account_id)
    return response

