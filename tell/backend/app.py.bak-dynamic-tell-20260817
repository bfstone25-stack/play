def _traffic_class(pid):
    p = (pid or "").casefold()
    return "test" if any(tag in p for tag in ("test", "audit", "e2e", "smoke")) else "organic"

def _opening(case, sid, lang):
    cf = CASEFILES[case["id"]]
    lk = _lang_key(lang)
    if lk == "zh": return cf["open_zh"][sid]
    pack = {"es": CASE_ES, "pt": CASE_PT, "ja": CASE_JA}.get(lk)
    if pack: return pack[case["id"]]["open"][sid]
    return cf["open_en"][sid]

def _route_intent(message, case, sid):
    """Social-MoE v0.8: multi-signal semantic routing, not a single magic word."""
    q = re.sub(r"\s+", " ", message.casefold().strip())
    other_names = [s["name"].casefold() for s in case["suspects"] if s["id"] != sid]
    scores = {intent: sum(1 for w in words if w in q) for intent, words in _INTENT_WORDS.items()}
    # Confrontation overrides the mentioned-name guard: "you said X, but Y" is
    # a direct challenge to the current witness even when another name appears.
    if scores["confrontation"]: return "confrontation", min(1.0, .72 + .12 * scores["confrontation"])
    if any(n in q for n in other_names): return "other_person", .95
    priority = ("accusation", "evidence", "method", "timeline", "motive")
    best = max(priority, key=lambda x: (scores[x], -priority.index(x)))
    if scores[best]: return best, min(.96, .58 + .14 * scores[best])
    # Questions still reach the actor instead of being converted to "unknown".
    return "general", .35

def _question_parts(message):
    """Split compound player input without breaking ordinary prose."""
    parts = [x.strip(" -\t") for x in re.split(r"[?？!！;；\n]+", message) if x.strip(" -\t")]
    return parts[:4] or [message.strip()]

def _compound_authored_reply(parts, case, sid, lang, allow_tell):
    """Answer every sub-question without inventing connective world facts."""
    lk = _lang_key(lang)
    answers = []
    tell_used = False
    for index, part in enumerate(parts, 1):
        part_intent, _ = _route_intent(part, case, sid)
        if part_intent == "method":
            if allow_tell and sid == case["solution"] and not tell_used:
                answer = _authored_tell(case["id"], lang)
                tell_used = True
            else:
                answer = _COVER_METHOD[lk]
        elif part_intent == "confrontation":
            answer = _authored_tell(case["id"], lang) if allow_tell and sid == case["solution"] else _CONFRONT_MORE[lk]
            tell_used = tell_used or (allow_tell and sid == case["solution"])
        elif part_intent == "other_person":
            answer = _SAFE_UNKNOWN[lk]
        elif part_intent in {"timeline", "motive", "evidence"}:
            answer = _opening(case, sid, lang)
        else:
            answer = _SAFE_UNKNOWN[lk]
        answers.append(f"{index}. {answer}")
    return "\n".join(answers)

def _retrieve_evidence(message, case, sid, intent):
    """HSM-LCR/RLS: retrieve only from case -> suspect -> relevant fact layers."""
    cf = CASEFILES[case["id"]]
    candidates = [("opening", cf["open_en"][sid])]
    candidates += [("fact", x) for x in cf["facts_en"]]
    candidates += [("persona", x.strip()) for x in re.split(r"(?<=[.!?])\s+", suspect_by_id(case, sid)["persona"])]
    words = set(re.findall(r"[a-z0-9]+", message.casefold()))
    scored = []
    for layer, text in candidates:
        overlap = len(words & set(re.findall(r"[a-z0-9]+", text.casefold())))
        bonus = 4 if layer == "opening" and intent == "timeline" else 2 if layer == "fact" else 0
        scored.append((overlap + bonus, layer, text))
    return [(layer, text) for score, layer, text in sorted(scored, reverse=True)[:5] if score > 0]

def _state_step(pid, case_id, suspect, mode, intent, pressured, evidence_key=""):
    if not pid: return None
    db = _db(); mode = "run" if mode == "run" else "daily"
    flags = {"timeline": (1,0,0,0), "method": (0,1,0,0),
             "evidence": (0,0,1,0), "confrontation": (0,0,0,1)}.get(intent, (0,0,0,0))
    db.execute("""INSERT INTO interrogation_state(
                    pid,case_id,suspect,mode,turns,pressure,tell_revealed,last_intent,updated,
                    timeline_seen,method_seen,evidence_seen,confrontations,last_evidence)
                  VALUES(?,?,?,?,1,?,0,?,?,?,?,?,?,?)
                  ON CONFLICT(pid,case_id,suspect,mode) DO UPDATE SET
                    turns=turns+1, pressure=pressure+excluded.pressure,
                    timeline_seen=max(timeline_seen,excluded.timeline_seen),
                    method_seen=max(method_seen,excluded.method_seen),
                    evidence_seen=max(evidence_seen,excluded.evidence_seen),
                    confrontations=confrontations+excluded.confrontations,
                    last_evidence=CASE WHEN excluded.last_evidence!='' THEN excluded.last_evidence ELSE last_evidence END,
                    last_intent=excluded.last_intent, updated=excluded.updated""",
               (pid[:64], case_id, suspect, mode, int(pressured), intent, time.time(),
                flags[0], flags[1], flags[2], flags[3], evidence_key[:64]))
    row = db.execute("""SELECT turns,pressure,tell_revealed,timeline_seen,method_seen,
                        evidence_seen,confrontations,last_evidence
                        FROM interrogation_state WHERE pid=? AND case_id=? AND suspect=? AND mode=?""",
                     (pid[:64], case_id, suspect, mode)).fetchone()
    db.commit(); db.close()
    return dict(zip(("turns","pressure","tell_revealed","timeline_seen","method_seen",
                     "evidence_seen","confrontations","last_evidence"), row))

def _mark_tell(pid, case_id, suspect, mode):
    if not pid: return
    db = _db(); db.execute("UPDATE interrogation_state SET tell_revealed=1,updated=? WHERE pid=? AND case_id=? AND suspect=? AND mode=?",
                           (time.time(), pid[:64], case_id, suspect, "run" if mode == "run" else "daily")); db.commit(); db.close()

def _tell_was_revealed(pid, case_id, suspect, mode):
    if not pid: return False
    db = _db()
    row = db.execute("""SELECT tell_revealed FROM interrogation_state
                        WHERE pid=? AND case_id=? AND suspect=? AND mode=?""",
                     (pid[:64], case_id, suspect, "run" if mode == "run" else "daily")).fetchone()
    db.close()
    return bool(row and row[0])

def _verify_candidate(reply, case, sid, intent, allow_tell=False):
    """BV-ToT verifier: reject unsafe branch and fall back to authored truth."""
    low = reply.casefold()
    if not reply.strip() or len(reply) > 520: return False, "empty_or_long"
    # Do not let natural role-play turn an authored broad alibi into a fabricated
    # precise timestamp (e.g. "all night" becoming "9:30 p.m.").
    authored = (CASEFILES[case["id"]]["open_en"][sid] + " " + suspect_by_id(case, sid)["persona"]).casefold()
    for exact_time in re.findall(r"\b\d{1,2}(?::\d{2})?\s*(?:a\.?m\.?|p\.?m\.?)\b", low):
        compact = re.sub(r"[^a-z0-9:]", "", exact_time)
        if compact not in re.sub(r"[^a-z0-9:]", "", authored):
            return False, "invented_exact_time"
    # The English authored dossier is canonical across translations. Reject a
    # translated reply that invents a numeric personal timestamp absent there.
    authored_numbers = set(re.findall(r"\d+(?::\d+)?", authored))
    for exact_time in re.findall(r"\d{1,2}(?::\d{2})?\s*(?:点|時|时)", reply):
        number = re.search(r"\d+(?::\d+)?", exact_time).group(0)
        if number not in authored_numbers:
            return False, "invented_exact_time"
    if intent == "other_person":
        if any(s["name"].casefold() in low for s in case["suspects"] if s["id"] != sid):
            return False, "other_person_claim"
    if sid != case["solution"]:
        if any(x.casefold() in low for x in _SECRET_MARKERS[case["id"]]):
            return False, "innocent_secret_leak"
    if sid == case["solution"] and not allow_tell:
        if any(x.casefold() in low for x in _SECRET_MARKERS[case["id"]]):
            return False, "premature_tell"
    return True, "verified"

def _chat(system, messages, max_tokens=160, temperature=0.45):
    _claim_tell_gpu(wait=True)
    body = json.dumps({"model": "tell", "max_tokens": max_tokens, "temperature": temperature,
                       "messages": [{"role": "system", "content": system}] + messages}).encode()
    req = urllib.request.Request(f"{LLAMACPP}/v1/chat/completions", data=body,
                                 headers={"Content-Type": "application/json"})
    return json.loads(urllib.request.urlopen(req, timeout=120).read())["choices"][0]["message"]["content"].strip()

def _claim_tell_gpu(wait=False):
    """Refresh TELL's GPU lease; the shared scheduler may pack two fitting models."""
    try:
        result = subprocess.run([os.path.expanduser("~/bin/llm_claim.sh"), "tell", "8809"],
                                timeout=90, check=False,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return result.returncode == 0
    except Exception as exc:
        print("[gpu-claim]", exc)
        return False

