[Unit]
Description=TELL mystery game backend
After=network.target
[Service]
WorkingDirectory=%h/Play/tell
ExecStart=%h/miniconda3/envs/hsm_lcr/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8918
Restart=on-failure
Environment=LLAMACPP_URL=http://127.0.0.1:8901
[Install]
WantedBy=default.target
