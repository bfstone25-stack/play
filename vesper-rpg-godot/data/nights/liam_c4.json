        "flag": "sees_him"
       },
       {
        "trust": 1
       },
       {
        "lines": "liam_c4:103-103"
       }
      ]
     }
    ]
   },
   {
    "lines": "liam_c4:120-120"
   },
   {
    "choice": [
     {
      "menu": "\"Then stop running. Stand still a second. I'll be right here.\"",
      "do": [
       {
        "flag": "stay_together"
       },
       {
        "trust": 1
       },
       {
        "lines": "liam_c4:121-121"
       }
      ]
     },
     {
      "menu": "\"That something isn't going anywhere. Whatever you choose.\"",
