   {
    "lines": "liam_c4:100-100"
   },
   {
    "choice": [
     {
      "menu": "\"Take it. And take me with you. I didn't move here for the town — I moved for you.\"",
      "do": [
       {
        "flag": "stay_together"
       },
       {
        "trust": 1
       },
       {
        "lines": "liam_c4:101-101"
       }
      ]
     },
     {
      "menu": "\"Don't take it for me. But don't turn it down for me either. Let's figure it out — together.\"",
      "do": [
       {
        "flag": "stay_together"
       },
       {
        "trust": 1
       },
       {
        "lines": "liam_c4:102-102"
       }
      ]
     },
     {
      "menu": "\"You've saved everyone else's home for ten years. Go build one you get to keep.\"",
