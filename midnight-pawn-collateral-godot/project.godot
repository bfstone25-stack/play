; Engine configuration file.
; Copied from ~/midnight-pawn-src/project.godot on Blaze Ubuntu and changed in three
; places only: the name, the description, and the Unlock autoload. The display block is
; byte-identical on purpose — the fork is the same 640x360 integer-scaled pixel canvas as
; the base game, because keeping the original's form is the whole point of this port.
config_version=5

[application]

config/name="Midnight Pawn: Collateral"
config/description="18+ adult fork of Midnight Pawn & Crypt. 2D pixel pawn-shop appraisal game: five clients, five objects, one descent into the Ossuary Market. Everyone depicted is an adult."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.08, 0.06, 0.1, 1)

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.05, 0.08, 1)

[gui]

theme/default_font="res://assets/fonts/midnight_pixel_12.fnt"
theme/default_font_size=12

[internationalization]

locale/fallback="en"

[input]

interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}

[autoload]

Gate="*res://scripts/gate.gd"
