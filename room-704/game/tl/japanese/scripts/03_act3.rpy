# game/scripts/03_act3.rpy:12
translate japanese act3_bf07ad66:

    # nar "She dresses the way she walked in out of the rain: without hurrying."
    nar "彼女は、雨の中を歩いてきた時と同じように身支度をする。急ぐ素振りはない。"

# game/scripts/03_act3.rpy:13
translate japanese act3_6cee9f47:

    # m "The car's gone."
    m "車は消えた。"

# game/scripts/03_act3.rpy:14
translate japanese act3_dff1b552:

    # you "He'll have gone to the station."
    you "彼は駅に行ったはずだ。"

# game/scripts/03_act3.rpy:15
translate japanese act3_d3e444e7:

    # m "Yes. He will."
    m "ええ、そうね。"

# game/scripts/03_act3.rpy:27
translate japanese end_train_22f8f170:

    # m "Then I won't go to the station."
    m "それなら、駅には行かないわ。"

# game/scripts/03_act3.rpy:28
translate japanese end_train_0ad5afee:

    # you "There's a bus from the corner at seven. It goes the wrong way for an hour and then it meets the same line four stops up."
    you "7時に角からバスが出る。1時間ほど逆方向へ進み、それから4つ先の停留所で同じ路線に合流する。"

# game/scripts/03_act3.rpy:29
translate japanese end_train_c3aae7de:

    # m "How do you know that?"
    m "どうしてそんなこと知ってるの？"

# game/scripts/03_act3.rpy:32
translate japanese end_train_d1686792:

    # m "Seven-oh-four."
    m "704。"

# game/scripts/03_act3.rpy:33
translate japanese end_train_b716a301:

    # you "I'll put it back on the board."
    you "私がボードに戻しておくわ。"

# game/scripts/03_act3.rpy:34
translate japanese end_train_ab978939:

    # m "Don't write it in the book."
    m "帳簿には書かないで。"

# game/scripts/03_act3.rpy:35
translate japanese end_train_a63c2723:

    # nar "You don't."
    nar "君は書かない。"

# game/scripts/03_act3.rpy:40
translate japanese end_together_003306e9:

    # m "Come with me to the corner, at least. Not the station. The corner."
    m "せめて角まで来て。駅じゃない。角よ。"

# game/scripts/03_act3.rpy:41
translate japanese end_together_c085fd95:

    # nar "You walk her down four flights and out through the doors you have watched all night from the wrong side."
    nar "君は彼女を四階分下へ連れて行く。そして、一晩中、間違った側から見ていたドアを通り、外へ出る。"

# game/scripts/03_act3.rpy:43
translate japanese end_together_db9e9c48:

    # m "If I write to the hotel, will it reach you?"
    m "もしホテルに手紙を書いたら、あなたに届くかしら？"

# game/scripts/03_act3.rpy:45
translate japanese end_together_cb9fa211:

    # m "Then I'll make it four."
    m "それなら、私が四通目にするわ。"

# game/scripts/03_act3.rpy:51
translate japanese end_alone_1f5d6182:

    # m "I'll take the station. He'll have given up by now, or he won't, and either way it stops being a thing I plan around."
    m "俺は駅に向かう。彼はもう諦めているだろう。あるいは、諦めていないだろう。どちらにせよ、俺がそれに合わせて動く必要はなくなる。"

# game/scripts/03_act3.rpy:53
translate japanese end_alone_c1305e19:

    # m "Thanks for the room."
    m "部屋、ありがとう。"

# game/scripts/03_act3.rpy:54
translate japanese end_alone_86eb65a1:

    # nar "At the door she stops, and does not turn around."
    nar "彼女はドアの前で立ち止まる。振り返らない。"

# game/scripts/03_act3.rpy:63
translate japanese epilogue_40bc425f:

    # nar "The day porter comes on at seven and asks if anything happened."
    nar "七時、日勤のポーターが出勤し、何かあったかと尋ねる。"

# game/scripts/03_act3.rpy:64
translate japanese epilogue_c5a0ffd5:

    # nar "You look at the register, where the fourth row of the fourth floor is a clean unbroken line, and you tell him it was a quiet night."
    nar "お前は帳簿を見る。四階の四番目の行は、きれいに空白のままだ。そして、静かな夜だったと彼に告げる。"

