static func conditional(key: String, flags: Dictionary) -> Array:
	match key:
		"ELI_FOLDER":
			return ["ナレーション", "イーライのファイルはまだ「在籍」と記されている。ただし端のページから褪せはじめている。ジュンの来客バッジが彼に買ってやれたのは時間であって、安全ではない。"] if flags.eli_stance == "TRUST" else ["ナレーション", "イーライのファイルは空で、湿ったバッジの輪郭だけが残っている。コンプライアンスは彼の証言を欠勤報告に書き換えた。"]
		"MARA_ELI":
			return ["マラ", "イーライは私の警告を六回のループ越しに運んでくれた。信じたからといって彼が助かったわけじゃない。でも、記録の中にもうひとり証人が残った。"] if flags.eli_stance == "TRUST" else ["マラ", "コンプライアンスは今、電話越しにイーライの息づかいを使っている。彼を通報したことで、どの恐怖があなたを動かせるのかをあれに教えてしまった。"]
		"ROUTE_PHONE":
			return ["イーライ / 電話", "階段の制御盤まで来た。ゲートを一つ、心臓の音で九十回ぶん押さえられる。もうそれを「秒」とは呼びたくない。"] if flags.eli_stance == "TRUST" else ["イーライ / 電話", "偏差というのは孤独な言葉だ。あなたはそれを僕のものにした。コンプライアンスは、名簿にある者にはエレベーターのほうが安全だと言っている。"]
		"STAIR_HELP":
			return ["イーライ", "ゲートは開いた。名前を呼び続けて。二人が同じ順番を覚えているあいだ、踊り場はリセットできない。"] if flags.eli_stance == "TRUST" else ["ナレーション", "階段の電話に出る者はいない。ジュンは偽造された辞職願の金属の綴じ針で、警報の接点を橋渡しする。"]
		"COAT_EVIDENCE":
			return ["ナレーション", "ジュンが階段を使ったおかげで、壁に刻まれた補充名簿がコート一着ごとの持ち主を裏づける。"] if flags.escape_route == "STAIRS" else ["ナレーション", "ラスクのキーカードが設備用のタグを開く。コートはすべて、再利用可能な身分材料として棚卸しされていた。"]
		"GATE_RESULT":
			return ["システム", "証人経路を受理。補充年表を添付した。"] if flags.escape_route == "STAIRS" else ["システム", "管理職経路を受理。上位権限を添付した。"]
		"PHOTO_ROUTE":
			return ["ナレーション", "階段の名簿は写真に写る全員を言い当てる。ラスクが顔を切り取った六人も含めて。"] if flags.escape_route == "STAIRS" else ["ナレーション", "ラスクのキーカードが額縁を開く。その裏にあるのは、消えた賃金とちょうど同額の退職金小切手だ。"]
		"WINDOW_ELI":
			return ["ナレーション", "イーライは庇の下でマラの隣に立ち、片手で階段の扉を押さえて待っている。"] if flags.eli_stance == "TRUST" else ["ナレーション", "歩道のマラの隣にあるのは、イーライの空白のバッジだけだ。雨がその顔写真を素通りしていく。"]
		"LOOP_COMPANION":
			if flags.eli_stance == "TRUST":
				return ["イーライ", "あなたは記録の半分を守った。監査官は半分を切り捨てる。僕はまだ、選択の辻褄を合わせてくれと頼めるだけは覚えている。"]
			return ["マラ", "コンプライアンスの道を通って、その行き着く先を自由とは呼べない。あれは私たちを、あなたの物語がまだ欠けていなかった最後の場所へ戻しただけ。"]
	return ["ナレーション", ""]
