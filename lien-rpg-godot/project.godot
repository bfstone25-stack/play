; LIEN — RPG. Godot 4.7 on the shared night_rpg core (addons/night_rpg is a symlink to
; play/night-rpg-core/addons/night_rpg). The 18+ fork of Midnight Pawn & Crypt, kept pixel:
; rooms and figures are 640x360-palette art doubled to the 1280x720 window.
config_version=5

[application]
config/name="LIEN"
config/description="18+ pawnshop RPG. Everyone depicted is an adult."
run/main_scene="res://addons/night_rpg/ui/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.027, 0.027, 0.043, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]
RPG="*res://addons/night_rpg/state.gd"
Loc="*res://addons/night_rpg/loc.gd"
Sound="*res://addons/night_rpg/sound.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
environment/defaults/default_clear_color=Color(0.027, 0.027, 0.043, 1)
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
